# Копирај во .env и попoлни вистински вредности:  cp .env.example .env
# .env НИКОГАШ не се commit-а (види .gitignore).

# ---- PostgreSQL (го користи и docker compose сервисот "db") ----
POSTGRES_DB=marketchecker
POSTGRES_USER=marketchecker
POSTGRES_PASSWORD=смени-ме
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Порт на кој Postgres се изложува на хостот (за psql / DBeaver).
# Смени го ако е зафатен од друг Postgres на машината.
POSTGRES_HOST_PORT=5434

# ---- Апликација ----
# Генерирај со: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=смени-ме-со-случаен-стринг
APP_ENV=development
LOG_LEVEL=INFO

# Порт на кој FastAPI се изложува на хостот
APP_HOST_PORT=8000

# ---- Читачи на ценовници ----
# Учтиво читање: пауза меѓу барања (секунди) и број на повторни обиди.
SCRAPER_USER_AGENT=Marketchecker/0.1 (+https://github.com/Darkosp/Marketcheker)
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=30

# ---- Пошта ----
# Без неа нема најава: сметката се активира и се отвора преку линк што
# стигнува на адресата на корисникот. Празен SMTP_HOST значи дека поштата
# НЕ се испраќа - линкот се запишува во дневникот, за локално тестирање.
# На production празен SMTP_HOST ја запира апликацијата.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@darbo.mk
# НЕ се commit-а. Се пишува само во .env на машината.
SMTP_PASSWORD=
SMTP_FROM=DARBOX Marketchecker <info@darbo.mk>
# Портот 465 носи TLS од првиот бајт; за 587 стави false (STARTTLS).
SMTP_SSL=true
# Проверка на сертификатот. Се гаси САМО ако хостингот нуди сертификат на
# друго име (чест случај кај споделен хостинг) - врската останува шифрирана.
SMTP_VERIFY=true

# Колку трае линкот од поштата (минути) и колку трае најавата (денови).
MAIL_LINK_MINUTES=60
SESSION_DAYS=90

# Адресата на која апликацијата е достапна. Влегува во линковите по пошта,
# кои се отвораат на друг уред - затоа „localhost" не чини за телефон.
# Дома: http://192.168.100.106:8000   На сервер: https://твојдомен
PUBLIC_URL=http://localhost:8000

# ---- Само за сервер (docker-compose.prod.yml) ----
# Домејнот што ќе го внесуваат луѓето. Caddy вади сертификат за него, па
# мора веќе да покажува на серверот пред да се стартува составот.
APP_DOMAIN=marketchecker.mk
# Е-пошта за Let's Encrypt (известување пред да истече сертификат).
ACME_EMAIL=ti@primer.mk
# Колку дена се чуваат дневните резервни копии во ./backups
BACKUP_KEEP_DAYS=14

# ---- Дневно закажување ----
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Skopje
SCHEDULER_HOUR=11
SCHEDULER_MINUTE=0
